{
  "name": "e57view",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:mcp && vite build",
    "preview": "vite preview",
    "wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path crates/e57-wasm/Cargo.toml && wasm-bindgen --target web --out-dir src/wasm crates/e57-wasm/target/wasm32-unknown-unknown/release/e57_wasm.wasm",
    "build:mcp": "esbuild mcp/server.mjs --bundle --platform=node --format=esm --target=node20 --outfile=public/mcp.mjs --external:bufferutil --external:utf-8-validate --log-level=warning --banner:js=\"import{createRequire as __e57cr}from'node:module';const require=__e57cr(import.meta.url);\"",
    "desktop:dev": "tauri dev --config desktop/tauri.conf.json",
    "desktop:build": "npm run build:desktop && node desktop/build.mjs",
    "build:desktop": "npm run build:mcp && vite build --mode desktop",
    "test:mcp": "node test-mcp.mjs",
    "dev:desktop": "vite --mode desktop",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/three": "^0.169.0",
    "playwright": "^1.55.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "three": "^0.169.0"
  },
  "license": "GPL-3.0-only",
  "description": "View, measure and edit multi-gigabyte point clouds in the browser or as a desktop app. Nothing is uploaded.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tGhattas/e57view.git"
  },
  "bugs": {
    "url": "https://github.com/tGhattas/e57view/issues"
  },
  "homepage": "https://github.com/tGhattas/e57view"
}
