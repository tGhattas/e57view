rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // a signed-in (anonymous) user uploads into their own folder; scans only, up to 20 GB
    match /uploads/{uid}/{cloudId}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024 * 1024
                   && file.matches('.*\\.(e57|E57|ply|PLY|las|LAS)$');
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    // converted cells: anyone with the link can view
    match /clouds/{cloudId}/{file} {
      allow read: if true;
      allow write: if false;
    }
  }
}
