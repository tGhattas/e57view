# build output
target/
dist/
dist-desktop/
pkg/
desktop/gen/
desktop/target/
.firebase/

# dependencies
node_modules/
functions/node_modules/
mcp/node_modules/

# secrets: never commit an env file, but do commit the example
.env
.env.*
*.env
!*.env.example

# WebAssembly, except the built artefacts the app and the Cloud Function ship
# (rebuild them with `npm run wasm` — see CONTRIBUTING.md)
*.wasm
!src/wasm/*.wasm
!functions/wasm/*.wasm

# built by `npm run build:mcp`
public/mcp.mjs

# whatever the drivers write. Scan data must never end up in this repository.
shots/
renders/
output/
tmp/
*.e57
*.las
*.laz
*.ptx

.DS_Store
